---
import '../styles/global.css';
const { title = 'umar.dev' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <nav>
      <a href="/">home</a>
    </nav>

    <slot />

    <footer>umar.dev</footer>
  </body>
</html>

<style>
  nav {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }
  nav a { color: #555; font-size: 13px; }
  nav a:hover { color: #aaa; }
  footer {
    margin-top: 5rem;
    font-size: 12px;
    color: #2a2a2a;
  }
</style>
