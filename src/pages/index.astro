---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = await getCollection('blog');
const sorted = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Base>
  <header class="site-header">
    <h1 class="site-name">Umar</h1>
  </header>

  <img
    class="home-banner"
    src="/images/manga-banner.png"
    alt=""
    width="1978"
    height="795"
    fetchpriority="high"
  />

  <div class="home-intro">
    <p>Hi, I'm Umar. I write software. Mostly backend systems.</p>
    <p>Nothing interesting to say about myself.</p>
    <p class="contact-links">
      <a href="https://github.com/UmxrAbdullxh" target="_blank" rel="noopener noreferrer">github</a>
      <span aria-hidden="true"> · </span>
      <a href="https://leetcode.com/u/UmarAbdullah/" target="_blank" rel="noopener noreferrer">leetcode</a>
      <span aria-hidden="true"> · </span>
      <a href="mailto:misschanandlerbong08@gmail.com">email</a>
    </p>
  </div>

  <section class="writing" aria-labelledby="writing-heading">
    <h2 class="writing-label" id="writing-heading">writing</h2>
    <ul class="post-list" role="list">
      {sorted.map((post) => (
        <li class="post-row">
          <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
          <time class="post-date" datetime={post.data.date.toISOString().slice(0, 10)}>
            {post.data.date.toLocaleDateString('en-US', {
              month: 'short', year: 'numeric', timeZone: 'UTC',
            })}
          </time>
        </li>
      ))}
    </ul>
  </section>
</Base>
