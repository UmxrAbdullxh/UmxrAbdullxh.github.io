---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const date = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<Base title={`${post.data.title} — Umar Shaikh`}>
  <div class="meta">
    <span>{date}</span>
  </div>

  <h1>{post.data.title}</h1>

  <article>
    <Content />
  </article>
</Base>

<style>
  .meta {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: #3a3a3a;
    margin-bottom: 2.5rem;
  }
  .meta a { color: #555; }
  .meta a:hover { color: #888; }
  h1 {
    font-size: 17px;
    font-weight: 500;
    color: #bbb;
    margin-bottom: 2.5rem;
    line-height: 1.5;
  }
  article {
    color: #777;
    line-height: 1.95;
    font-size: 14px;
    font-family: 'Courier New', Courier, monospace;
  }
  article :global(p) { margin-bottom: 1.5rem; }
  article :global(h2) {
    font-size: 14px;
    font-weight: 500;
    color: #999;
    margin: 2rem 0 1rem;
  }
  article :global(code) {
    background: #1a1a1a;
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 13px;
    color: #888;
  }
  article :global(pre) {
    background: #161616;
    border: 0.5px solid #222;
    border-radius: 4px;
    padding: 1rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }
  article :global(pre code) {
    background: none;
    padding: 0;
  }
  article :global(blockquote) {
    border-left: 2px solid #2a2a2a;
    padding-left: 1rem;
    color: #555;
    margin: 1.5rem 0;
  }
</style>
